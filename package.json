{
  "name": "the-big-slop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "node scripts/local-server.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:generate": "drizzle-kit generate",
    "worker": "node services/worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node tests/self-host-smoke.mjs",
    "test:workers": "node tests/worker-planning-smoke.mjs && node tests/worker-reference-smoke.mjs && node tests/worker-recovery-smoke.mjs && node tests/worker-continuity-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.3",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5",
    "fflate@>=0.7.0 <0.7.5": "0.7.5"
  },
  "description": "An open-source, self-hosted filmmaking studio. From script to references, storyboards and a finished film.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/leviseyes/the-big-slop.git"
  },
  "homepage": "https://github.com/leviseyes/the-big-slop#readme",
  "bugs": {
    "url": "https://github.com/leviseyes/the-big-slop/issues"
  }
}
